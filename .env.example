# ── Arkiv Memory Tier (NEW — Web3 Database Builder Challenge) ──
# Braga is Arkiv's testnet (settles to Hoodi → Ethereum). Native gas: GLM.
# Faucet: https://braga.hoodi.arkiv.network/faucet/
ARKIV_RPC_URL=https://braga.hoodi.arkiv.network/rpc
ARKIV_WS_URL=wss://braga.hoodi.arkiv.network/rpc/ws
ARKIV_PROJECT_ATTRIBUTE=fhedin-ethns-2c4f9a
# Backend-relay wallet — owns/extends every memory entity ($creator filter target).
ARKIV_BACKEND_PRIVATE_KEY=
ARKIV_BACKEND_WALLET=
# Memory-Agent v1 — signs LearnedFact payloads (signature-recovery → on-chain provenance).
MEMORY_AGENT_PRIVATE_KEY=
MEMORY_AGENT_WALLET=
# Demo buyer (used by scripts/demo-arkiv-memory-market.ts).
DEMO_BUYER_PRIVATE_KEY=
DEMO_BUYER_WALLET=
# Toggle for the read-prior → decide → write-back cycle in demo-agent.ts.
MEMORY_AGENT_ENABLED=false
# Default memory TTL (30 days, in seconds).
MEMORY_DEFAULT_TTL_SECONDS=2592000
# Pay-to-extend price (re-uses existing x402 PaymentGate).
MEMORY_EXTEND_USDC=0.01
NEXT_PUBLIC_ARKIV_RPC_URL=https://braga.hoodi.arkiv.network/rpc
NEXT_PUBLIC_ARKIV_PROJECT_ATTRIBUTE=fhedin-ethns-2c4f9a
NEXT_PUBLIC_ARKIV_BACKEND_WALLET=
NEXT_PUBLIC_ARKIV_BLOCK_EXPLORER=https://explorer.braga.hoodi.arkiv.network
NEXT_PUBLIC_ARKIV_DATA_EXPLORER=https://data.arkiv.network
