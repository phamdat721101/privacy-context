# ── Contracts ──────────────────────────────────────────────
RPC_URL_ARBITRUM_SEPOLIA=https://sepolia-rollup.arbitrum.io/rpc
RPC_URL_ARBITRUM=https://arb1.arbitrum.io/rpc
DEPLOYER_PRIVATE_KEY=
ARBISCAN_API_KEY=

# ── Second Brain Backend ────────────────────────────────────
DATABASE_URL=postgresql://brain:changeme@localhost:5432/fhe_brain
POSTGRES_PASSWORD=changeme
REDIS_HOST=localhost
REDIS_PORT=6379
OPENAI_API_KEY=
# Set to "off" to force /v3/discover onto the TF-IDF floor strategy even if
# BEDROCK_API_KEY or OPENAI_API_KEY is present. Default = on whenever a
# provider key is configured. The home page chat box and /marketplace
# concierge both honor this flag.
OPENX_DISCOVERY_LLM=on
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs
PRIVATE_KEY=
PLATFORM_WALLET=
SUBSCRIPTION_CONTROLLER_ADDRESS=
KNOWLEDGE_REGISTRY_ADDRESS=
BRAIN_KEY_VAULT_ADDRESS=
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
BASE_SEPOLIA_RPC=https://sepolia.base.org
PORT=3001

# ── Agent (legacy) ─────────────────────────────────────────
AGENT_PRIVATE_KEY=
CONTEXT_MANAGER_ADDRESS=
MEMORY_STORE_ADDRESS=
AGENT_REGISTRY_ADDRESS=

# ── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_AGENT_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_SUBSCRIPTION_CONTROLLER_ADDRESS=
NEXT_PUBLIC_KNOWLEDGE_REGISTRY_ADDRESS=
NEXT_PUBLIC_BRAIN_KEY_VAULT_ADDRESS=
NEXT_PUBLIC_CONTEXT_MANAGER_ADDRESS=
NEXT_PUBLIC_MEMORY_STORE_ADDRESS=
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_AGENT_ADDRESS=

# ── Platform signer (server-side) ────────────────────────────
# Used by cognitiveMemoryService to sign platform-relayed memory writes.
# Backward-compat: ARKIV_BACKEND_PRIVATE_KEY is still honored if this is unset.
PLATFORM_SIGNER_PRIVATE_KEY=

# ── Private payment (T4–T7) ──────────────────────────────────
# Populated by deploy-fhe-pay.ts; copy from deployments/arbitrum-sepolia.json.
WRAPPED_USDC_ADDRESS=
AGENT_BILLING_ADDRESS=
SETTLEMENT_LEDGER_ADDRESS=
NEXT_PUBLIC_WRAPPED_USDC_ADDRESS=
NEXT_PUBLIC_AGENT_BILLING_ADDRESS=
NEXT_PUBLIC_SETTLEMENT_LEDGER_ADDRESS=

# Feature flags (T5–T7)
# FEATURE_FHE_PAY=true enables /v4 routes, freemium gate, and the one-tap UI.
# FEATURE_FHE_PAY=false (default) preserves byte-identical v2 behaviour.
FEATURE_FHE_PAY=false
# Free-preview limit per (wallet × brain). Set to 0 to disable freemium entirely.
FREE_PREVIEW_LIMIT=5

# Feature flag — PRD-19 gasless non-crypto seller onboarding (Arbitrum Sepolia).
# When true, the publish path enqueues a chain_ops_queue row and the worker's
# chain-relayer drains it (signs createBrain() with RELAYER_PRIVATE_KEY).
# When false (default), publish stays DB-only — byte-identical to PRD-18.
# Also gates the /v4 mount, so /v4/admin/stats becomes reachable for relayer
# observability without enabling FHERC20.
FEATURE_GASLESS_ONBOARD=false
# Relayer wallet — pre-funded EOA that signs gasless on-chain ops. Defaults
# to DEPLOYER_PRIVATE_KEY when unset, keeping existing deploy infra unchanged.
# Fund with ≥0.005 ETH on Arbitrum Sepolia (~1000 onboards). Slack alert
# fires once/hour via SLACK_ALERTS_WEBHOOK when balance drops below 0.005.
RELAYER_PRIVATE_KEY=
# Optional: webhook for low-balance + future ops alerts. Empty → no alerts.
SLACK_ALERTS_WEBHOOK=
# Worker poll interval (ms). Default 5000 — single hot wallet, low cadence.
RELAYER_POLL_MS=5000

# ── Trustless tier — Sui + Walrus + SEAL + Tatum Gateway ─────
# All optional in dev (the SDK falls back to mocks). Required for mainnet.
TATUM_API_KEY=
SUI_RPC_URL=https://sui-mainnet.gateway.tatum.io
SUI_TESTNET_RPC_URL=https://sui-testnet.gateway.tatum.io

# Walrus endpoints — Tatum Gateway-routed by default; override for direct.
WALRUS_PUBLISHER_URL=https://publisher.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus.space
WALRUS_TESTNET_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_TESTNET_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# Sui Move package + sub-objects (populated by `sui client publish`).
# OPENX_BRAIN_PACKAGE_ID is the deployed package ID for fhe_brain modules.
OPENX_BRAIN_PACKAGE_ID=
# OPENX_USDC_COIN_TYPE is the canonical USDC type on Sui mainnet for `subscribe<T>`.
OPENX_USDC_COIN_TYPE=0x5d4b302506645c37ff133b98c4b50a5ae14841659738d6d733d59d0d217a93bf::coin::COIN

# SEAL threshold key servers — comma-separated. Empty → mock client.
SEAL_KEY_SERVERS=
SEAL_THRESHOLD=2

# Phala TEE (Confidential AI) — shared with Standard tier; attestation hash
# is recorded back into the Sui PaymentReceipt object on each paid query.
PHALA_ENDPOINT=
PHALA_API_KEY=
PHALA_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Hosted MCP server URL (Phase 1 = HTTP at api.openx.so/mcp).
OPENX_MCP_PUBLIC_URL=https://api.openx.so/mcp
# Buyer-side OpenX API key for `@openx/mcp` clients.
OPENX_API_KEY=

# Tatum webhook signing secret (rotate via Tatum dashboard).
TATUM_WEBHOOK_SECRET=
# Public webhook URL the API exposes for Tatum to POST (used in subscribe call).
OPENX_TATUM_WEBHOOK_URL=https://api.openx.so/v3/webhooks/tatum-notifications

# ── MemWal × OpenX (PRD-05 to 12) ────────────────────────────
# Walrus Memory testnet IDs (https://docs.wal.app/walrus-memory).
# Switching MEMWAL_NETWORK to 'mainnet' changes the package + registry below.
MEMWAL_NETWORK=testnet
MEMWAL_PACKAGE_ID=0xcf6ad755a1cdff7217865c796778fabe5aa399cb0cf2eba986f4b582047229c6
MEMWAL_REGISTRY_ID=0xe80f2feec1c139616a86c9f71210152e2a7ca552b20841f2e192f99f75864437
MEMWAL_RELAYER_URL=https://relayer-staging.memory.walrus.xyz

# Peer-dependency gate. When false, OpenXMemWalAdapter throws an actionable
# OpenXMemWalUpstreamMissingError instead of importing @mysten-incubation/memwal.
# Flip to true once the peer dep is installed in the deployment image.
MEMWAL_PEERDEP_ENABLED=false

# OpenX-operated delegate-key pool (PRD-11). Comma-separated Ed25519 hex keys.
# These keys live on the SELLER's MemWalAccount, not OpenX's — the operator
# pattern leans on MemWal's per-seller 60 pts/min budget.
OPENX_MEMWAL_DELEGATE_PRIVATE_KEYS=
OPENX_MEMWAL_DELEGATE_LABEL=openx-operator-staging

# OpenX operator Sui wallet — Bech32 `suiprivkey1…` form (modern). This is the
# wallet that pays Sui gas for: delegate registration, billing-event emission,
# and revenue-split settlement batches. NOT the seller's wallet.
OPENX_OPERATOR_SUI_PRIVATE_KEY=

# OpenX MCP gateway (PRD-09).
OPENX_MCP_GATEWAY_PORT=3007
OPENX_MCP_AUTH_REQUIRED_MODE=true
OPENX_MCP_MAX_TOTAL_SESSIONS=1000
OPENX_MCP_MAX_SESSIONS_PER_IP=16

# OPENX_MCP_AUTH_MODE — how MemWal tool calls are routed (PRD-09 §5):
#   openx-bound (default) — through OpenX API, operator pool holds delegate keys.
#   memwal-direct         — direct to MemWal relayer using ~/.memwal/credentials.json.
#   hybrid                — tool-prefix split: openx_memwal_* via OpenX, memwal_* direct.
OPENX_MCP_AUTH_MODE=openx-bound

# FHE × MemWal envelope (PRD-07). Default OFF — flip per invited enterprise customer.
FHE_MEMWAL_ENABLE=false
# Master secret for HKDF-derived per-namespace orthogonal matrices + AES keys.
# MUST be a 32+ byte random string in production. Never commit; rotate per cohort.
FHE_MEMWAL_MASTER_SECRET=

# OpenX MCP gateway feature flags (PRD-09 §10). All default OFF.
OPENX_MCP_ENABLE_FHE_ENVELOPE=false
OPENX_MCP_ENABLE_BUNDLE_DISCOUNT=false
OPENX_MCP_ENABLE_TEAM_SHARING=false
OPENX_MCP_ENABLE_FREE_TIER=false
OPENX_MCP_ENABLE_DELEGATE_REWRITE=false

# ── Marketplace v1 (PRD-A/B/C — seller-first onboarding) ────
# Off by default. When 'true', the /seller/onboard wizard is reachable
# from the AppShell nav. Routes under /v3/marketplace/* are always
# mounted; the flag only gates the UI surface for byte-identical
# rollback. Migration 023 must be applied before flipping this on.
FEATURE_MARKETPLACE_V1=false
# Seller-first onboarding v2 (PRD-14/15/16) — 5-step wizard with seller↔agent
# split, workflow + skill listing kinds, and network-aware PrivacyMode router.
# When false, the publish endpoint accepts the v1 payload byte-identically; the
# v2 wizard fields land via defaults but no new behaviour is exposed.
FEATURE_MARKETPLACE_V1_SELLER_FIRST=false

# PRD-18 — Permit-authenticated one-prompt onboarding.
# When 'false' (default), POST /v3/marketplace/seller/publish accepts BOTH
# x-wallet-address (legacy) and x-fhenix-permit (new). When 'true', the
# x-wallet-address path on /seller/publish is rejected with 401 and only the
# scoped onboard permit minted at /docs is honored. All other routes are
# unaffected by this flag — single switch, single route, byte-identical
# rollback. Migration 025 must be applied before flipping this on.
FEATURE_PERMIT_AUTH=false
